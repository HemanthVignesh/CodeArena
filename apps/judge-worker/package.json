{
  "name": "@codearena/judge-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run src/runners/runners.test.ts src/evaluators/comparator.test.ts",
    "test:sandbox": "vitest run src/sandbox.integration.test.ts src/submission.integration.test.ts src/run.integration.test.ts --fileParallelism=false --testTimeout=120000",
    "test:runner": "tsx src/test-runner.ts",
    "sandbox:build": "bash sandboxes/build.sh",
    "sandbox:build:python": "docker build -t codearena-python:3.12 sandboxes/python",
    "sandbox:build:cpp": "docker build -t codearena-cpp:13 sandboxes/cpp",
    "sandbox:build:typescript": "docker build -t codearena-typescript:20 sandboxes/typescript"
  },
  "dependencies": {
    "@codearena/db": "workspace:*",
    "@codearena/judge-shared": "workspace:*",
    "bullmq": "^5.12.14",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@codearena/tsconfig": "workspace:*",
    "@types/node": "^20.16.5",
    "eslint": "^8.57.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}
