{
  "name": "@codearena/judge-shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@codearena/tsconfig": "workspace:*",
    "eslint": "^8.57.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
